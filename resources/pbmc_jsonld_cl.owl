    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd8_em">
    <rdfs:label>CD8+ Effector Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000913"/>
    <skos:prefLabel>effector memory CD8-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD8-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-negative, and CCR7-negative.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
