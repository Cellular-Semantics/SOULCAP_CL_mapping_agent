    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/t1_t2_b">
    <rdfs:label>Transitional B Cell Type 1/2</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000818"/>
    <skos:prefLabel>transitional stage B cell</skos:prefLabel>
    <skos:definition>An immature B cell of an intermediate stage between the pre-B cell stage and the mature naive stage with the phenotype surface IgM-positive and CD19-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001937"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27-/CD38hi</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:exclusionExpression>CD14-/CD3-/CD56-/CD27-</pbmc:exclusionExpression>
    <pbmc:conditionalMarkers rdf:resource="http://pbmc-standards.org/"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd4_em">
    <rdfs:label>CD4+ Effector Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000905"/>
    <skos:prefLabel>effector memory CD4-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD4-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-negative, and CCR7-negative.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD197-/CD45RA-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/naive_b">
    <rdfs:label>Naive B Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000788"/>
    <skos:prefLabel>naive B cell</skos:prefLabel>
    <skos:definition>A mature B cell that has the phenotype IgD-positive, CD27-negative, and IgM-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002238"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002109"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27-/CD38lo/-/CD24-/IgD+/IgMlo</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001824"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/mature_b">
        <rdfs:label>Mature B Cell</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000785"/>
        <skos:prefLabel>mature B cell</skos:prefLabel>
        <skos:definition>A B cell that is mature, having left the bone marrow. Initially, these cells are IgM+, IgD+, CD23+, CD5-, CD10-, surface Ig+.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
        <pbmc:markerExpression>live/CD45+/CD19+/CD27-/CD38lo/-</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
        <pbmc:exclusionExpression>CD14-/CD3-/CD56-/CD27-</pbmc:exclusionExpression>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/pdc">
    <rdfs:label>Plasmacytoid Dendritic Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000784"/>
    <skos:prefLabel>plasmacytoid dendritic cell</skos:prefLabel>
    <skos:definition>A dendritic cell type of distinct morphology, localization, and surface marker expression (CD123-positive) from other dendritic cell types and associated with early stage immune responses.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/dendritic"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
    <pbmc:markerExpression>live/CD45+/CD123hi/CD193-/CD16-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/nk_bright">
    <rdfs:label>CD56bright NK Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000623"/>
    <skos:prefLabel>natural killer cell</skos:prefLabel>
    <skos:definition>A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/nk_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001127"/>
    <pbmc:markerExpression>live/CD45+/CD56hi/CD127-/lo/CD16-/lo/CD57-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/nk"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>CD56bright NK subset with regulatory function</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/igg_mem">
    <rdfs:label>IgG Memory B Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000972"/>
    <skos:prefLabel>class switched memory B cell</skos:prefLabel>
    <skos:definition>A memory B cell that has undergone Ig class switching and expresses IgG.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002152"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27+/CD38lo/-/IgD-/IgM-/IgA-/IgG+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002238"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002109"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002007"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/switched">
        <rdfs:label>Class-Switched Memory B Cell</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000972"/>
        <skos:prefLabel>class switched memory B cell</skos:prefLabel>
        <skos:definition>A memory B cell that has undergone Ig class switching and therefore does not express IgM or IgD on the cell surface.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
        <pbmc:markerExpression>live/CD45+/CD19+/CD27+/CD38lo/-/IgD-/IgM-</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002238"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002109"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/bmem"/>
        <pbmc:pathway>memory</pbmc:pathway>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>IgG-expressing class-switched memory B cell</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd8_cm">
    <rdfs:label>CD8+ Central Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000909"/>
    <skos:prefLabel>central memory CD8-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD8-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-positive, and CCR7-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4-/CD8+/CD197+/CD45RA-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd8t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/iga_mem">
    <rdfs:label>IgA Memory B Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000972"/>
    <skos:prefLabel>class switched memory B cell</skos:prefLabel>
    <skos:definition>A memory B cell that has undergone Ig class switching and expresses IgA.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002007"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27+/CD38lo/-/IgD-/IgM-/IgA+/IgG-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002238"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002109"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002152"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/switched"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>IgA-expressing class-switched memory B cell</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/mait">
    <rdfs:label>MAIT Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000940"/>
    <skos:prefLabel>mucosal invariant T cell</skos:prefLabel>
    <skos:definition>An invariant T cell that is found in the lamina propria of mucosal tissues, is CD4-negative, CD8-positive, and is capable of mounting an immune response to mucosal pathogens.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/mait_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001432"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD56+/-/TCRgd-/TCR Va7.2+/CD161+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/t_lymph">
        <rdfs:label>T Lymphocyte</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000084"/>
        <skos:prefLabel>T cell</skos:prefLabel>
        <skos:definition>A type of lymphocyte whose defining characteristic is the expression of a T cell receptor complex.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:markerExpression>live/CD45+/CD3+</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/neutrophil">
    <rdfs:label>Neutrophil</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000775"/>
    <skos:prefLabel>neutrophil</skos:prefLabel>
    <skos:definition>A mature granulocyte that is readily stainable with neutral dyes, which is most abundant in peripheral blood and contains a multilobed nucleus and cytoplasmic granules.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/granulocytes">
        <rdfs:label>Granulocyte Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000094"/>
        <skos:prefLabel>granulocyte</skos:prefLabel>
        <dcterms:description>Polymorphonuclear leukocyte lineage</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
    <pbmc:markerExpression>live/CD45+/CD193-/CD16hi</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/basophil">
    <rdfs:label>Basophil</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000767"/>
    <skos:prefLabel>basophil</skos:prefLabel>
    <skos:definition>A mature granulocyte that is readily stainable with basic dyes, has cytoplasmic granules, and functions in allergic reactions.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/granulocytes"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001074"/>
    <pbmc:markerExpression>live/CD45+/CD123+/CD193+/CD16-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd4_naive">
    <rdfs:label>CD4+ Naive T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000895"/>
    <skos:prefLabel>naive thymus-derived CD4-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD4-positive, alpha-beta T cell that has not been activated in the periphery, is CD45RA-positive, CD45RO-negative, CD62L-positive, and CD127-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD197+/CD45RA+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/monocytes">
    <rdfs:label>Monocyte Lineage</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000576"/>
    <skos:prefLabel>monocyte</skos:prefLabel>
    <dcterms:description>Mononuclear phagocyte lineage</dcterms:description>
  </pbmc:LineageType>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/bdn">
    <rdfs:label>Double Negative B Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000785"/>
    <skos:prefLabel>mature B cell</skos:prefLabel>
    <skos:definition>A B cell that is mature, having left the bone marrow.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27-/CD38lo/-/CD24-/IgD-/IgM-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001824"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/mature_b"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>Double negative (IgD-/IgM-) B cell subset</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/gdT">
    <rdfs:label>Gamma Delta T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000798"/>
    <skos:prefLabel>gamma-delta T cell</skos:prefLabel>
    <skos:definition>A T cell that expresses a gamma-delta T cell receptor complex.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/gd_t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:markerExpression>live/CD45+/CD3+/TCRgd+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/t_lymph"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/eosinophil">
    <rdfs:label>Eosinophil</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000771"/>
    <skos:prefLabel>eosinophil</skos:prefLabel>
    <skos:definition>A mature granulocyte that is readily stainable with acidic dyes, contains large granules, and has a bilobed nucleus.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/granulocytes"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001074"/>
    <pbmc:markerExpression>live/CD45+/CD193+/CD16-/CD123-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd4_cm">
    <rdfs:label>CD4+ Central Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000904"/>
    <skos:prefLabel>central memory CD4-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD4-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-positive, and CCR7-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD197+/CD45RA-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/th1">
    <rdfs:label>CD4+ Th1 Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000545"/>
    <skos:prefLabel>T-helper 1 cell</skos:prefLabel>
    <skos:definition>A CD4-positive, alpha-beta T cell that has the phenotype T-bet-positive, CXCR3-positive, CCR6-negative, and is capable of producing interferon-gamma.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001046"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD185-/CD183+/CD196-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001185"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>functional</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/ilc1">
    <rdfs:label>Type 1 Innate Lymphoid Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0001141"/>
    <skos:prefLabel>type 1 innate lymphoid cell</skos:prefLabel>
    <skos:definition>An innate lymphoid cell that is capable of producing interferon-gamma and lacks expression of transcription factors that define ILC2s and ILC3s.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/ilc"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001127"/>
    <pbmc:markerExpression>live/CD45+/CD3-/CD127+/CD56-/CD117-/CD294-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000942"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/ilc"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/intermediate_mono">
    <rdfs:label>Intermediate Monocyte</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000875"/>
    <skos:prefLabel>non-classical monocyte</skos:prefLabel>
    <skos:definition>A monocyte that is CD14-positive, CD16-positive.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/monocytes"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
    <pbmc:markerExpression>live/CD45+/CD14+/CD16hi</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/mono">
        <rdfs:label>Monocyte</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000576"/>
        <skos:prefLabel>monocyte</skos:prefLabel>
        <skos:definition>A mononuclear phagocyte that is a mature or maturing myeloid cell, typically large, prepare by the bone marrow from a monoblast and found in the blood.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/monocytes"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:markerExpression>live/CD45+/CD14lo/+/CD11c+/-</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>Intermediate monocyte subset with mixed phenotype</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd4_temra">
    <rdfs:label>CD4+ Terminal Effector Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000907"/>
    <skos:prefLabel>CD45RA-positive, CD62L-negative, CCR7-negative, alpha-beta T cell</skos:prefLabel>
    <skos:definition>An alpha-beta T cell that is CD45RA-positive, CD62L-negative, and CCR7-negative.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD197-/CD45RA+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>CD4+ subset of TEMRA cells</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:PathwayType rdf:about="http://pbmc-standards.org/terms/functional_pathway">
    <rdfs:label>Functional Subset Pathway</rdfs:label>
    <dcterms:description>T cell functional subset classifications</dcterms:description>
    <pbmc:subsets>th2</pbmc:subsets>
    <pbmc:subsets>th1</pbmc:subsets>
    <pbmc:subsets>treg</pbmc:subsets>
    <pbmc:subsets>tfh</pbmc:subsets>
    <pbmc:subsets>th17</pbmc:subsets>
  </pbmc:PathwayType>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/treg">
    <rdfs:label>Regulatory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000815"/>
    <skos:prefLabel>regulatory T cell</skos:prefLabel>
    <skos:definition>A T cell which regulates overall immune responses as well as the responses of other T cell subsets through direct cell-cell contact and cytokine release.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001823"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD25+/CD127lo/-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd4t"/>
    <pbmc:pathway>functional</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/classical_mono">
    <rdfs:label>Classical Monocyte</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000860"/>
    <skos:prefLabel>classical monocyte</skos:prefLabel>
    <skos:definition>A monocyte that is CD14-positive and CD16-negative with a central role in antimicrobial responses and wound healing.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/monocytes"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:markerExpression>live/CD45+/CD14+/CD16-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/mono"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/nonclassical_mono">
    <rdfs:label>Non-Classical Monocyte</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000875"/>
    <skos:prefLabel>non-classical monocyte</skos:prefLabel>
    <skos:definition>A monocyte that is CD14-low, CD16-positive and has a patrolling behavior.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/monocytes"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
    <pbmc:markerExpression>live/CD45+/CD14lo/CD16+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/mono"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:PathwayType rdf:about="http://pbmc-standards.org/terms/memory_pathway">
    <rdfs:label>Memory Differentiation Pathway</rdfs:label>
    <dcterms:description>T cell memory differentiation states</dcterms:description>
    <pbmc:stages>central_memory</pbmc:stages>
    <pbmc:stages>effector_memory</pbmc:stages>
    <pbmc:stages>naive</pbmc:stages>
    <pbmc:stages>terminal_effector</pbmc:stages>
  </pbmc:PathwayType>
</rdf:RDF>
