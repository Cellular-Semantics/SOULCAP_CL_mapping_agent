    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001127"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/ilc3">
    <rdfs:label>Type 3 Innate Lymphoid Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0001068"/>
    <skos:prefLabel>type 3 innate lymphoid cell</skos:prefLabel>
    <skos:definition>An innate lymphoid cell that is capable of producing IL-17 and/or IL-22 and requires transcription factor Ror-gt for development.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/ilc"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
