  <pbmc:ImmunePopulationDataset rdf:about="http://pbmc-standards.org/pbmc-dataset-v1.0">
    <dcterms:title>Standardized Human PBMC Immunophenotyping Dataset with Cell Ontology Integration</dcterms:title>
    <dcterms:description>Comprehensive characterization of immune cell populations from healthy human peripheral blood mononuclear cells with Cell Ontology integration</dcterms:description>
    <dcterms:version>1.1.0</dcterms:version>
