    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001057"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4+/CD8-/CD185-/CD183-/CD196-/CD194+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001185"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001046"/>
