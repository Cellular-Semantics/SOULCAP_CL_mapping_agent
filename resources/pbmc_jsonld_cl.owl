  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/bmem">
    <rdfs:label>Memory B Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000787"/>
    <skos:prefLabel>memory B cell</skos:prefLabel>
    <skos:definition>A mature B cell that is long-lived, readily activated upon re-encounter of its antigenic determinant, and has the phenotype CD27-positive.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/b_cells">
        <rdfs:label>B Cell Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000236"/>
        <skos:prefLabel>B cell</skos:prefLabel>
        <dcterms:description>B lymphocyte lineage from bone marrow</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001851"/>
    <pbmc:markerExpression>live/CD45+/CD19+/CD27+/CD38lo/-</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:parentPopulation>
      <pbmc:RootPopulation rdf:about="http://pbmc-standards.org/live_cells">
        <rdfs:label>Live Cells</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000003"/>
        <skos:prefLabel>native cell</skos:prefLabel>
        <skos:definition>A cell that is found in a natural setting, which includes multicellular organism cells 'in vivo' and unicellular organisms 'in environment'.</skos:definition>
        <dcterms:description>Live cell gate excluding dead cells and debris using fixable viability dye exclusion</dcterms:description>
        <pbmc:markers>Fixable viability dye negative</pbmc:markers>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</pbmc:tier>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:RootPopulation>
    </pbmc:parentPopulation>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/nk_dim">
    <rdfs:label>CD56dim NK Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000623"/>
    <skos:prefLabel>natural killer cell</skos:prefLabel>
    <skos:definition>A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/nk_cells">
        <rdfs:label>NK Cell Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000623"/>
        <skos:prefLabel>natural killer cell</skos:prefLabel>
        <dcterms:description>Innate lymphoid cytotoxic cells</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
    <pbmc:markerExpression>live/CD45+/CD56+/dim/CD127-/lo/CD16+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/nk">
        <rdfs:label>Natural Killer Cell</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000623"/>
        <skos:prefLabel>natural killer cell</skos:prefLabel>
        <skos:definition>A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation via germline encoded activation receptors and also regulate immune responses via cytokine release and direct contact with other cells.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/nk_cells"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
        <pbmc:markerExpression>live/CD45+/CD56+/hi/CD127-/lo</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001199"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</pbmc:exactMatch>
    <skos:broader rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</skos:broader>
    <rdfs:comment>CD56dim NK subset with cytotoxic function</rdfs:comment>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/ilc2">
    <rdfs:label>Type 2 Innate Lymphoid Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0001067"/>
    <skos:prefLabel>type 2 innate lymphoid cell</skos:prefLabel>
    <skos:definition>An innate lymphoid cell that is capable of producing IL-5, IL-13, and IL-4 and requires transcription factor Gata3 for development.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/ilc">
        <rdfs:label>ILC Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0001065"/>
        <skos:prefLabel>innate lymphoid cell</skos:prefLabel>
        <dcterms:description>Innate immune lymphocytes</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001127"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001848"/>
    <pbmc:markerExpression>live/CD45+/CD3-/CD127+/CD56-/CD117lo/-/CD294+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000942"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/ilc">
        <rdfs:label>Innate Lymphoid Cell</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0001065"/>
        <skos:prefLabel>innate lymphoid cell</skos:prefLabel>
        <skos:definition>A lymphocyte that lacks antigen specific receptors and is part of the innate immune system.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/ilc"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001127"/>
        <pbmc:markerExpression>live/CD45+/CD3-/CD127+</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000942"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/live_cells"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd8_naive">
    <rdfs:label>CD8+ Naive T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000900"/>
    <skos:prefLabel>naive thymus-derived CD8-positive, alpha-beta T cell</skos:prefLabel>
    <skos:definition>A CD8-positive, alpha-beta T cell that has not been activated in the periphery, is CD45RA-positive, CD45RO-negative, CD62L-positive, and CD127-positive.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/t_cells">
        <rdfs:label>T Cell Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000084"/>
        <skos:prefLabel>T cell</skos:prefLabel>
        <dcterms:description>T lymphocyte lineage from thymus</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001308"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001336"/>
    <pbmc:markerExpression>live/CD45+/CD3+/CD4-/CD8+/CD197+/CD45RA+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
    <pbmc:parentPopulation>
      <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd8t">
        <rdfs:label>CD8+ T Cell</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000625"/>
        <skos:prefLabel>CD8-positive, alpha-beta T cell</skos:prefLabel>
        <skos:definition>A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD8 coreceptor.</skos:definition>
        <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
        <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000927"/>
        <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000949"/>
        <pbmc:markerExpression>live/CD45+/CD3+/CD56-/TCRgd-/TCR Va7.2-/CD4-/CD8+</pbmc:markerExpression>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001002"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000932"/>
        <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001380"/>
        <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/t_lymph"/>
        <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
      </pbmc:ImmunePopulation>
    </pbmc:parentPopulation>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/mdc">
    <rdfs:label>Myeloid Dendritic Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000782"/>
    <skos:prefLabel>myeloid dendritic cell</skos:prefLabel>
    <skos:definition>A dendritic cell of the myeloid lineage that is CD11c-positive.</skos:definition>
    <pbmc:lineage>
      <pbmc:LineageType rdf:about="http://pbmc-standards.org/terms/dendritic">
        <rdfs:label>Dendritic Cell Lineage</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000451"/>
        <skos:prefLabel>dendritic cell</skos:prefLabel>
        <dcterms:description>Professional antigen-presenting cells</dcterms:description>
      </pbmc:LineageType>
    </pbmc:lineage>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pbmc:tier>
