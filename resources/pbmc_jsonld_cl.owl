    <pbmc:parentPopulation rdf:resource="http://pbmc-standards.org/cd8t"/>
    <pbmc:pathway>memory</pbmc:pathway>
    <pbmc:exactMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</pbmc:exactMatch>
  </pbmc:ImmunePopulation>
  <pbmc:ImmunePopulation rdf:about="http://pbmc-standards.org/cd8_temra">
    <rdfs:label>CD8+ Terminal Effector Memory T Cell</rdfs:label>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000907"/>
    <skos:prefLabel>CD45RA-positive, CD62L-negative, CCR7-negative, alpha-beta T cell</skos:prefLabel>
    <skos:definition>An alpha-beta T cell that is CD45RA-positive, CD62L-negative, and CCR7-negative.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/t_cells"/>
    <pbmc:tier rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pbmc:tier>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001309"/>
