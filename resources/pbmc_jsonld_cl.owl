    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CL_0000946"/>
    <skos:prefLabel>antibody secreting cell</skos:prefLabel>
    <skos:definition>A lymphocyte of B lineage that is devoted to secreting large amounts of immunoglobulin.</skos:definition>
    <pbmc:lineage rdf:resource="http://pbmc-standards.org/terms/b_cells"/>
