    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000000999"/>
    <pbmc:positiveMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000002015"/>
    <pbmc:markerExpression>live/CD45+/CD3-/CD11c+/HLA-DR+</pbmc:markerExpression>
    <pbmc:negativeMarkers rdf:resource="http://purl.obolibrary.org/obo/PR_000001020"/>
