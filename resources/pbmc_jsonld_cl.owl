    <dcterms:license>https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    <dcterms:source>Standardized flow cytometry protocols for human PBMC analysis</dcterms:source>
    <pbmc:sampleType>Peripheral Blood Mononuclear Cells</pbmc:sampleType>
    <pbmc:species>Homo sapiens</pbmc:species>
