    skos:exactMatch obo:CL_0000236 ;
    skos:prefLabel "B cell" .

<http://pbmc-standards.org/live_cells> a pbmc:RootPopulation ;
    rdfs:label "Live Cells" ;
    pbmc:exactMatch true ;
    pbmc:markers "Fixable viability dye negative" ;
    pbmc:tier 1 ;
    dcterms:description "Live cell gate excluding dead cells and debris using fixable viability dye exclusion" ;
    skos:definition "A cell that is found in a natural setting, which includes multicellular organism cells 'in vivo' and unicellular organisms 'in environment'." ;
    skos:exactMatch obo:CL_0000003 ;
    skos:prefLabel "native cell" .

pbmc:t_cells a pbmc:LineageType ;
    rdfs:label "T Cell Lineage" ;
    dcterms:description "T lymphocyte lineage from thymus" ;
    skos:exactMatch obo:CL_0000084 ;
    skos:prefLabel "T cell" .

