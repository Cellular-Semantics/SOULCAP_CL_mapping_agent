<http://pbmc-standards.org/classical_mono> a pbmc:ImmunePopulation ;
    rdfs:label "Classical Monocyte" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:monocytes ;
    pbmc:markerExpression "live/CD45+/CD14+/CD16-" ;
    pbmc:negativeMarkers obo:PR_000000927,
        obo:PR_000001005,
        obo:PR_000001020,
        obo:PR_000001380 ;
    pbmc:parentPopulation <http://pbmc-standards.org/mono> ;
    pbmc:positiveMarkers obo:PR_000001002,
        obo:PR_000001309 ;
    pbmc:tier 4 ;
    skos:definition "A monocyte that is CD14-positive and CD16-negative with a central role in antimicrobial responses and wound healing." ;
    skos:exactMatch obo:CL_0000860 ;
    skos:prefLabel "classical monocyte" .

<http://pbmc-standards.org/eosinophil> a pbmc:ImmunePopulation ;
    rdfs:label "Eosinophil" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:granulocytes ;
    pbmc:markerExpression "live/CD45+/CD193+/CD16-/CD123-" ;
    pbmc:negativeMarkers obo:PR_000000927,
        obo:PR_000001002,
        obo:PR_000001020,
        obo:PR_000001380 ;
    pbmc:parentPopulation <http://pbmc-standards.org/live_cells> ;
    pbmc:positiveMarkers obo:PR_000001074,
        obo:PR_000001309 ;
    pbmc:tier 2 ;
    skos:definition "A mature granulocyte that is readily stainable with acidic dyes, contains large granules, and has a bilobed nucleus." ;
    skos:exactMatch obo:CL_0000771 ;
    skos:prefLabel "eosinophil" .

<http://pbmc-standards.org/gdT> a pbmc:ImmunePopulation ;
    rdfs:label "Gamma Delta T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:gd_t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/TCRgd+" ;
    pbmc:negativeMarkers obo:PR_000001002 ;
    pbmc:parentPopulation <http://pbmc-standards.org/t_lymph> ;
    pbmc:positiveMarkers obo:PR_000000927,
        obo:PR_000001309 ;
    pbmc:tier 4 ;
    skos:definition "A T cell that expresses a gamma-delta T cell receptor complex." ;
    skos:exactMatch obo:CL_0000798 ;
    skos:prefLabel "gamma-delta T cell" .

<http://pbmc-standards.org/iga_mem> a pbmc:ImmunePopulation ;
    rdfs:label "IgA Memory B Cell" ;
    pbmc:exactMatch false ;
    pbmc:lineage pbmc:b_cells ;
    pbmc:markerExpression "live/CD45+/CD19+/CD27+/CD38lo/-/IgD-/IgM-/IgA+/IgG-" ;
    pbmc:negativeMarkers obo:PR_000000927,
        obo:PR_000001002,
        obo:PR_000001380,
        obo:PR_000002109,
        obo:PR_000002152,
        obo:PR_000002238 ;
    pbmc:parentPopulation <http://pbmc-standards.org/switched> ;
    pbmc:pathway "memory" ;
    pbmc:positiveMarkers obo:PR_000001020,
        obo:PR_000001309,
        obo:PR_000001851,
        obo:PR_000002007 ;
    pbmc:tier 4 ;
    rdfs:comment "IgA-expressing class-switched memory B cell" ;
    skos:broader true ;
    skos:definition "A memory B cell that has undergone Ig class switching and expresses IgA." ;
    skos:exactMatch obo:CL_0000972 ;
    skos:prefLabel "class switched memory B cell" .

<http://pbmc-standards.org/igg_mem> a pbmc:ImmunePopulation ;
    rdfs:label "IgG Memory B Cell" ;
    pbmc:exactMatch false ;
    pbmc:lineage pbmc:b_cells ;
    pbmc:markerExpression "live/CD45+/CD19+/CD27+/CD38lo/-/IgD-/IgM-/IgA-/IgG+" ;
