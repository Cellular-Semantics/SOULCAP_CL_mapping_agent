    skos:exactMatch obo:CL_0000909 ;
    skos:prefLabel "central memory CD8-positive, alpha-beta T cell" .

<http://pbmc-standards.org/cd8_em> a pbmc:ImmunePopulation ;
    rdfs:label "CD8+ Effector Memory T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4-/CD8+/CD197-/CD45RA-" ;
