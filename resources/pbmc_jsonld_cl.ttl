    pbmc:tier 4 ;
    rdfs:comment "CD4+ subset of TEMRA cells" ;
    skos:broader true ;
    skos:definition "An alpha-beta T cell that is CD45RA-positive, CD62L-negative, and CCR7-negative." ;
    skos:exactMatch obo:CL_0000907 ;
    skos:prefLabel "CD45RA-positive, CD62L-negative, CCR7-negative, alpha-beta T cell" .

<http://pbmc-standards.org/cd8_cm> a pbmc:ImmunePopulation ;
    rdfs:label "CD8+ Central Memory T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4-/CD8+/CD197+/CD45RA-" ;
