<http://pbmc-standards.org/pbmc-dataset-v1.0> a pbmc:ImmunePopulationDataset ;
    pbmc:lineageHierarchy ( pbmc:b_cells pbmc:t_cells pbmc:nk_cells pbmc:monocytes pbmc:granulocytes pbmc:dendritic pbmc:ilc ) ;
    pbmc:markerDefinitions [ obo:PR_000000927 [ dcterms:description "T-cell receptor complex, T cell marker" ;
                    dcterms:title "CD3 epsilon" ;
                    schema1:name "CD3" ] ;
            obo:PR_000000932 [ dcterms:description "T-helper cell surface glycoprotein" ;
                    dcterms:title "CD4 molecule" ;
                    schema1:name "CD4" ] ;
            obo:PR_000000942 [ dcterms:description "Hematopoietic progenitor cell antigen" ;
                    dcterms:title "CD34 molecule" ;
                    schema1:name "CD34" ] ;
            obo:PR_000000949 [ dcterms:description "T-lymphocyte differentiation antigen" ;
                    dcterms:title "CD8 alpha" ;
                    schema1:name "CD8" ] ;
            obo:PR_000000999 [ dcterms:description "ITGAX, dendritic cell marker" ;
                    dcterms:title "integrin subunit alpha X" ;
                    schema1:name "CD11c" ] ;
            obo:PR_000001002 [ dcterms:description "Monocyte differentiation antigen" ;
                    dcterms:title "CD14 molecule" ;
                    schema1:name "CD14" ] ;
            obo:PR_000001005 [ dcterms:description "Low affinity immunoglobulin gamma Fc region receptor III-A" ;
                    dcterms:title "Fc gamma receptor IIIA" ;
                    schema1:name "CD16" ] ;
            obo:PR_000001014 [ dcterms:description "c-Kit, stem cell factor receptor" ;
                    dcterms:title "KIT proto-oncogene receptor tyrosine kinase" ;
                    schema1:name "CD117" ] ;
            obo:PR_000001020 [ dcterms:description "B-lymphocyte antigen CD19, B cell marker" ;
                    dcterms:title "CD19 molecule" ;
                    schema1:name "CD19" ] ;
            obo:PR_000001046 [ dcterms:description "CXCR3, Th1 cell marker" ;
                    dcterms:title "C-X-C motif chemokine receptor 3" ;
                    schema1:name "CD183" ] ;
            obo:PR_000001057 [ dcterms:description "CCR4, Th2 cell marker" ;
                    dcterms:title "C-C motif chemokine receptor 4" ;
                    schema1:name "CD194" ] ;
            obo:PR_000001074 [ dcterms:description "CCR3, eosinophil marker" ;
                    dcterms:title "C-C motif chemokine receptor 3" ;
                    schema1:name "CD193" ] ;
            obo:PR_000001127 [ dcterms:description "IL-7 receptor alpha chain" ;
                    dcterms:title "interleukin 7 receptor" ;
                    schema1:name "CD127" ] ;
            obo:PR_000001185 [ dcterms:description "CXCR5, follicular helper T cell marker" ;
                    dcterms:title "C-X-C motif chemokine receptor 5" ;
                    schema1:name "CD185" ] ;
            obo:PR_000001199 [ dcterms:description "IL-3 receptor alpha chain" ;
                    dcterms:title "interleukin 3 receptor subunit alpha" ;
                    schema1:name "CD123" ] ;
            obo:PR_000001308 [ dcterms:description "CCR7, lymph node homing receptor" ;
                    dcterms:title "C-C motif chemokine receptor 7" ;
                    schema1:name "CD197" ] ;
            obo:PR_000001309 [ dcterms:description "Leukocyte common antigen, pan-leukocyte marker" ;
                    dcterms:title "protein tyrosine phosphatase receptor type C" ;
                    schema1:name "CD45" ] ;
            obo:PR_000001336 [ dcterms:description "CD45 isoform A, naive cell marker" ;
                    dcterms:title "protein tyrosine phosphatase receptor type C isoform" ;
                    schema1:name "CD45RA" ] ;
            obo:PR_000001380 [ dcterms:description "NK cell marker, NCAM1" ;
                    dcterms:title "neural cell adhesion molecule 1" ;
                    schema1:name "CD56" ] ;
            obo:PR_000001432 [ dcterms:description "KLRB1, MAIT cell marker" ;
                    dcterms:title "killer cell lectin like receptor B1" ;
                    schema1:name "CD161" ] ;
            obo:PR_000001823 [ dcterms:description "IL-2 receptor alpha chain" ;
                    dcterms:title "interleukin 2 receptor subunit alpha" ;
                    schema1:name "CD25" ] ;
            obo:PR_000001824 [ dcterms:description "Heat stable antigen" ;
                    dcterms:title "CD24 molecule" ;
                    schema1:name "CD24" ] ;
            obo:PR_000001848 [ dcterms:description "CRTH2, ILC2 marker" ;
                    dcterms:title "prostaglandin D2 receptor 2" ;
                    schema1:name "CD294" ] ;
            obo:PR_000001851 [ dcterms:description "TNF receptor superfamily member 7" ;
                    dcterms:title "CD27 molecule" ;
                    schema1:name "CD27" ] ;
            obo:PR_000001937 [ dcterms:description "ADP-ribosyl cyclase/cyclic ADP-ribose hydrolase 1" ;
                    dcterms:title "CD38 molecule" ;
                    schema1:name "CD38" ] ;
            obo:PR_000002007 [ dcterms:description "Immunoglobulin A heavy chain" ;
                    dcterms:title "immunoglobulin heavy constant alpha 1" ;
                    schema1:name "IgA" ] ;
            obo:PR_000002015 [ dcterms:description "MHC class II antigen presentation" ;
                    dcterms:title "major histocompatibility complex class II DR" ;
                    schema1:name "HLA-DR" ] ;
            obo:PR_000002109 [ dcterms:description "Immunoglobulin M heavy chain" ;
                    dcterms:title "immunoglobulin heavy constant mu" ;
                    schema1:name "IgM" ] ;
            obo:PR_000002152 [ dcterms:description "Immunoglobulin G heavy chain" ;
                    dcterms:title "immunoglobulin heavy constant gamma 1" ;
                    schema1:name "IgG" ] ;
            obo:PR_000002238 [ dcterms:description "Immunoglobulin D heavy chain" ;
                    dcterms:title "immunoglobulin heavy constant delta" ;
                    schema1:name "IgD" ] ] ;
    pbmc:pathwayClassifications ( pbmc:memory_pathway pbmc:functional_pathway ) ;
    pbmc:populations ( <http://pbmc-standards.org/live_cells> <http://pbmc-standards.org/asc> <http://pbmc-standards.org/t1_t2_b> <http://pbmc-standards.org/mature_b> <http://pbmc-standards.org/naive_b> <http://pbmc-standards.org/bdn> <http://pbmc-standards.org/bmem> <http://pbmc-standards.org/switched> <http://pbmc-standards.org/iga_mem> <http://pbmc-standards.org/igg_mem> <http://pbmc-standards.org/t_lymph> <http://pbmc-standards.org/cd4t> <http://pbmc-standards.org/cd8t> <http://pbmc-standards.org/cd4_naive> <http://pbmc-standards.org/cd4_cm> <http://pbmc-standards.org/cd4_em> <http://pbmc-standards.org/cd4_temra> <http://pbmc-standards.org/treg> <http://pbmc-standards.org/th1> <http://pbmc-standards.org/th2> <http://pbmc-standards.org/cd8_naive> <http://pbmc-standards.org/cd8_cm> <http://pbmc-standards.org/cd8_em> <http://pbmc-standards.org/cd8_temra> <http://pbmc-standards.org/gdT> <http://pbmc-standards.org/mait> <http://pbmc-standards.org/nk> <http://pbmc-standards.org/nk_bright> <http://pbmc-standards.org/nk_dim> <http://pbmc-standards.org/mono> <http://pbmc-standards.org/classical_mono> <http://pbmc-standards.org/nonclassical_mono> <http://pbmc-standards.org/intermediate_mono> <http://pbmc-standards.org/neutrophil> <http://pbmc-standards.org/eosinophil> <http://pbmc-standards.org/basophil> <http://pbmc-standards.org/pdc> <http://pbmc-standards.org/mdc> <http://pbmc-standards.org/ilc> <http://pbmc-standards.org/ilc1> <http://pbmc-standards.org/ilc2> <http://pbmc-standards.org/ilc3> ) ;
    pbmc:sampleType "Peripheral Blood Mononuclear Cells" ;
    pbmc:species "Homo sapiens" ;
    pbmc:usageGuidelines [ a pbmc:UsageGuidelines ;
            pbmc:dataSharing "Freely available for research and commercial use" ;
            pbmc:updates "Check for updates at http://pbmc-standards.org/" ;
            dcterms:bibliographicCitation "Please cite this dataset when used in publications" ;
            dcterms:license "https://creativecommons.org/licenses/by/4.0/" ] ;
    pbmc:validationMetadata [ a pbmc:ValidationInfo ;
            pbmc:clVersion "2024-05-15" ;
            pbmc:prVersion "2024-04-01" ;
            pbmc:validationCriteria [ a pbmc:ValidationCriteria ;
                    pbmc:broaderMatchCriteria "Population is a subtype of existing CL term" ;
                    pbmc:exactMatchCriteria "Population directly maps to existing CL term" ;
                    pbmc:relatedMatchCriteria "Population is related but not exact match to CL term" ] ;
            pbmc:validationDate "2025-01-01" ;
            dcterms:creator "PBMC Standards Consortium" ] ;
    dcterms:created "2025-01-01" ;
    dcterms:description "Comprehensive characterization of immune cell populations from healthy human peripheral blood mononuclear cells with Cell Ontology integration" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:source "Standardized flow cytometry protocols for human PBMC analysis" ;
    dcterms:title "Standardized Human PBMC Immunophenotyping Dataset with Cell Ontology Integration" ;
    dcterms:version "1.1.0" .

<http://pbmc-standards.org/asc> a pbmc:ImmunePopulation ;
    rdfs:label "Antibody Secreting Cell" ;
    pbmc:conditionalMarkers <http://pbmc-standards.org/> ;
    pbmc:exactMatch true ;
    pbmc:exclusionExpression "CD14-/CD3-/CD56-" ;
    pbmc:lineage pbmc:b_cells ;
    pbmc:markerExpression "live/CD45+/CD19+/-/CD27hi/CD38hi" ;
    pbmc:negativeMarkers obo:PR_000000927,
        obo:PR_000001002,
        obo:PR_000001380 ;
    pbmc:parentPopulation <http://pbmc-standards.org/live_cells> ;
    pbmc:positiveMarkers obo:PR_000001020,
        obo:PR_000001309,
        obo:PR_000001851,
        obo:PR_000001937 ;
    pbmc:tier 3 ;
    skos:definition "A lymphocyte of B lineage that is devoted to secreting large amounts of immunoglobulin." ;
    skos:exactMatch obo:CL_0000946 ;
    skos:prefLabel "antibody secreting cell" .

<http://pbmc-standards.org/basophil> a pbmc:ImmunePopulation ;
    rdfs:label "Basophil" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:granulocytes ;
    pbmc:markerExpression "live/CD45+/CD123+/CD193+/CD16-" ;
    pbmc:negativeMarkers obo:PR_000001002 ;
    pbmc:parentPopulation <http://pbmc-standards.org/live_cells> ;
    pbmc:positiveMarkers obo:PR_000001074,
        obo:PR_000001199,
        obo:PR_000001309 ;
    pbmc:tier 2 ;
    skos:definition "A mature granulocyte that is readily stainable with basic dyes, has cytoplasmic granules, and functions in allergic reactions." ;
    skos:exactMatch obo:CL_0000767 ;
    skos:prefLabel "basophil" .

<http://pbmc-standards.org/bdn> a pbmc:ImmunePopulation ;
    rdfs:label "Double Negative B Cell" ;
    pbmc:exactMatch false ;
    pbmc:lineage pbmc:b_cells ;
    pbmc:markerExpression "live/CD45+/CD19+/CD27-/CD38lo/-/CD24-/IgD-/IgM-" ;
    pbmc:negativeMarkers obo:PR_000000927,
        obo:PR_000001002,
        obo:PR_000001380,
        obo:PR_000001824,
        obo:PR_000001851 ;
    pbmc:parentPopulation <http://pbmc-standards.org/mature_b> ;
    pbmc:positiveMarkers obo:PR_000001020,
        obo:PR_000001309 ;
    pbmc:tier 4 ;
    rdfs:comment "Double negative (IgD-/IgM-) B cell subset" ;
    skos:broader true ;
    skos:definition "A B cell that is mature, having left the bone marrow." ;
    skos:exactMatch obo:CL_0000785 ;
    skos:prefLabel "mature B cell" .

<http://pbmc-standards.org/cd4_cm> a pbmc:ImmunePopulation ;
    rdfs:label "CD4+ Central Memory T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4+/CD8-/CD197+/CD45RA-" ;
    pbmc:negativeMarkers obo:PR_000000949,
        obo:PR_000001002,
        obo:PR_000001336 ;
    pbmc:parentPopulation <http://pbmc-standards.org/cd4t> ;
    pbmc:pathway "memory" ;
    pbmc:positiveMarkers obo:PR_000000927,
        obo:PR_000000932,
        obo:PR_000001308,
        obo:PR_000001309 ;
    pbmc:tier 4 ;
    skos:definition "A CD4-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-positive, and CCR7-positive." ;
    skos:exactMatch obo:CL_0000904 ;
    skos:prefLabel "central memory CD4-positive, alpha-beta T cell" .

<http://pbmc-standards.org/cd4_em> a pbmc:ImmunePopulation ;
    rdfs:label "CD4+ Effector Memory T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4+/CD8-/CD197-/CD45RA-" ;
    pbmc:negativeMarkers obo:PR_000000949,
        obo:PR_000001002,
        obo:PR_000001308,
        obo:PR_000001336 ;
    pbmc:parentPopulation <http://pbmc-standards.org/cd4t> ;
    pbmc:pathway "memory" ;
    pbmc:positiveMarkers obo:PR_000000927,
        obo:PR_000000932,
        obo:PR_000001309 ;
    pbmc:tier 4 ;
    skos:definition "A CD4-positive, alpha-beta T cell that is CD45RA-negative, CD45RO-positive, CD62L-negative, and CCR7-negative." ;
    skos:exactMatch obo:CL_0000905 ;
    skos:prefLabel "effector memory CD4-positive, alpha-beta T cell" .

<http://pbmc-standards.org/cd4_naive> a pbmc:ImmunePopulation ;
    rdfs:label "CD4+ Naive T Cell" ;
    pbmc:exactMatch true ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4+/CD8-/CD197+/CD45RA+" ;
    pbmc:negativeMarkers obo:PR_000000949,
        obo:PR_000001002 ;
    pbmc:parentPopulation <http://pbmc-standards.org/cd4t> ;
    pbmc:pathway "memory" ;
    pbmc:positiveMarkers obo:PR_000000927,
        obo:PR_000000932,
        obo:PR_000001308,
        obo:PR_000001309,
        obo:PR_000001336 ;
    pbmc:tier 4 ;
    skos:definition "A CD4-positive, alpha-beta T cell that has not been activated in the periphery, is CD45RA-positive, CD45RO-negative, CD62L-positive, and CD127-positive." ;
    skos:exactMatch obo:CL_0000895 ;
    skos:prefLabel "naive thymus-derived CD4-positive, alpha-beta T cell" .

<http://pbmc-standards.org/cd4_temra> a pbmc:ImmunePopulation ;
    rdfs:label "CD4+ Terminal Effector Memory T Cell" ;
    pbmc:exactMatch false ;
    pbmc:lineage pbmc:t_cells ;
    pbmc:markerExpression "live/CD45+/CD3+/CD4+/CD8-/CD197-/CD45RA+" ;
